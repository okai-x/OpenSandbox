# OpenSandbox region asia-southeast1 (Singapore), the first region. It was
# built by hand before bootstrap-region.sh existed and is zonal; this file
# records its parameters so the regression and load-test scripts can target it.
PROJECT=pranalab-infra
REGION=asia-southeast1
LOCATION=asia-southeast1-b
CLUSTER=opensandbox
MASTER_AUTHORIZED_NETWORKS=103.54.154.119/32

SYSTEM_NODE_LOCATIONS=asia-southeast1-b
SYSTEM_MACHINE=e2-standard-4

SANDBOX_POOL=sandbox-c3d60
SANDBOX_MACHINE=c3d-highcpu-60
SANDBOX_DISK_TYPE=pd-balanced
SANDBOX_DISK_GB=200
SANDBOX_NODE_LOCATIONS=asia-southeast1-b
SANDBOX_MIN_NODES=1
SANDBOX_MAX_NODES=8

ARTIFACTS_BUCKET=pranalab-infra-opensandbox-artifacts
# Source of truth for images; other regions copy from here (sync-images.sh).
REGISTRY=asia-southeast1-docker.pkg.dev/pranalab-infra/opensandbox

# OpenSandbox region asia-south1 (Mumbai). Read by bootstrap-region.sh.
PROJECT=pranalab-infra
REGION=asia-south1
# Regional cluster: the control plane and node pools span the zones below.
LOCATION=asia-south1
CLUSTER=opensandbox-asia-south1
MASTER_AUTHORIZED_NETWORKS=103.54.154.119/32

# System pool (server, controller, gateway, collector): one node per zone.
SYSTEM_NODE_LOCATIONS=asia-south1-a,asia-south1-b
SYSTEM_MACHINE=e2-standard-4

# Sandbox pool: one machine type per region. n4d-highcpu-96 fits 11 sandboxes
# of 8 CPU / 12Gi. The node counts are totals across the zones.
SANDBOX_POOL=sandbox-n4d96
SANDBOX_MACHINE=n4d-highcpu-96
SANDBOX_DISK_TYPE=hyperdisk-balanced
SANDBOX_DISK_GB=200
SANDBOX_NODE_LOCATIONS=asia-south1-a,asia-south1-b,asia-south1-c
SANDBOX_MIN_NODES=0
SANDBOX_MAX_NODES=8

ARTIFACTS_BUCKET=pranalab-infra-opensandbox-artifacts-asia-south1
# Region-local copy of the images (sync-images.sh).
REGISTRY=asia-south1-docker.pkg.dev/pranalab-infra/opensandbox
